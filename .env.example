# Supabase — create a project at https://supabase.com, then copy these from
# Project Settings → API Keys. The app runs without them (quote engine works
# from seeded in-memory demo data), but auth, saved quotes and leads need
# Supabase. Classic and new-style key names are both accepted:
#   public key:  NEXT_PUBLIC_SUPABASE_ANON_KEY (JWT)  or
#                NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (sb_publishable_...)
#   secret key:  SUPABASE_SERVICE_ROLE_KEY (JWT)  or
#                SUPABASE_SECRET_KEY (sb_secret_...)
# The secret key is server-only and REQUIRED in Supabase mode: the quote flow
# (saving/loading quote snapshots) and admin actions both use it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Resend — transactional email (lead notifications). Optional: when absent,
# emails are logged to the server console instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Bizim Kargo <noreply@example.com>"

# Absolute base URL of the deployed site (used in emails and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
